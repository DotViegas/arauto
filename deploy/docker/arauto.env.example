# Copy to arauto.env and fill in. arauto.env holds a password: never put it in a repository.

# The password of the database. Long and random; only the hub and the database use it.
POSTGRES_PASSWORD=

# The address the connectors reach from outside. https:// and only the host (and port).
ARAUTO_PUBLIC_URL=https://arauto.example.org

# The proxies whose word about the address of a connector is taken, AS THE HUB SEES THEM.
# With the proxy on this server pointing at 127.0.0.1:8443, the hub does not see 127.0.0.1
# nor the address of the server: it sees the gateway of a Docker network of the composition.
# These two are the gateways compose.yaml fixes. With a wrong list the hub still starts,
# ignores the header, and says so once in its log; every connector then seems to come from
# one address.
ARAUTO_TRUSTED_PROXIES=172.30.250.1,172.30.251.1

# The port of the connectors on this machine, where the proxy finds the hub.
ARAUTO_PORT=8443

# The network the WhatsApp engine is on, to reach the hub at http://hub:8444.
ARAUTO_ENGINE_NETWORK=arauto-engine
