# The defaults of the recipe for Easypanel. What is set in Environment of Easypanel comes
# after this file and wins. Nothing here is a secret.

# At the first passkey of the panel, the hub replaces the password the database is born
# with by one it draws and keeps in its data folder (docs/decisoes/0041).
ARAUTO_DATABASE_PASSWORD=rotate-at-first-access

# The proxy of Easypanel, as the hub sees it: the network both are on. This is the one seen
# on one installation of Easypanel, on 13/11/2026; it may differ on yours. With a wrong list
# the hub still starts and says so once in its log, with the address that is missing: put it
# in Environment as ARAUTO_TRUSTED_PROXIES.
ARAUTO_TRUSTED_PROXIES=10.11.0.0/16

# What the hub says in its log.
RUST_LOG=info
